<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: Anka bütün alanı kaplar; seri sayısı üstte, mesaj altta üzerine biner (her boyda düzgün görünür) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg_done">
    <ImageView android:id="@+id/w_img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingTop="34dp" android:paddingBottom="34dp" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:scaleType="fitCenter" android:src="@drawable/anka_w_happy" android:contentDescription="Anka" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start"
        android:layout_marginStart="12dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_flame" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/w_flame_on" android:contentDescription="Seri" />
        <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-black" />
    </LinearLayout>
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp"
        android:background="@drawable/w_pill" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:text="Bugün tamam!" android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
</FrameLayout>
